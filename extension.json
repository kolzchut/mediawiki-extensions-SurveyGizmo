{
	"name": "SurveyGizmo Intercept Loader",
	"version": "0.4.1",
	"author": [
		"Dror S. [FFS] ([http://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-SurveyGizmo",
	"descriptionmsg": "surveygizmo-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"MessagesDirs": {
		"SurveyGizmo": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\SurveyGizmo\\": "includes/"
	},
	"ResourceModules": {
		"ext.surveyGizmo": {
			"scripts": "ext.surveyGizmo.interceptLoader.js",
			"styles": "ext.surveyGizmo.interceptLoader.less",
			"dependencies": [
				"mediawiki.cookie"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikiRights/SurveyGizmo/resources"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\SurveyGizmo\\Hooks",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"ResourceLoaderGetConfigVars": "main"
	},
	"config": {
		"SurveyGizmoBeaconID": {
			"value": null
		},
		"SurveyGizmoBeaconUrl": {
			"value": null
		}
	},
	"manifest_version": 2
}
